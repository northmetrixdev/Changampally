# Google Gemini API Key for Website RAG Chatbot
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Flag to activate the chatbot backend (set to 'true' once API key is provided)
CHATBOT_ENABLED=false

# Public site URL (canonical domain, used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.changampally.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) — set the real value in Vercel
NEXT_PUBLIC_GA_ID=
